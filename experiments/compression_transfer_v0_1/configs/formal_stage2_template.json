{
  "programme": "compression-transfer-v0.1-stage2-cipher-generator-controls",
  "manifest": "../data/formal_stage2_manifest.csv",
  "output_dir": "../results/formal_stage2",
  "verify_hashes": true,
  "compressors": ["zlib9", "bz2_9", "lzma9e", "zstd19", "ppmd6"],
  "require_all_compressors": false,
