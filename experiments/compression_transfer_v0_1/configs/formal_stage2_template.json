  "probe_units": 4096,
  "probe_stride": 4096,
  "reference_units": 131072,
  "max_probes_per_document": 8,
  "registered_gates": {
    "surface_class_macro_accuracy_min": 0.80,
    "surface_class_worst_recall_min": 0.60,
    "consensus_coverage_min": 0.75,
    "generator_disjoint_accuracy_min": 0.75,
    "fresh_key_source_language_accuracy_min": 0.70,
    "each_required_cipher_family_source_accuracy_min": 0.50,
    "matched_null_false_positive_rate_max": 0.05
