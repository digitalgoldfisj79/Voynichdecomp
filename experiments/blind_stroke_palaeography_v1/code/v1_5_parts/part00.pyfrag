def log(event: str, **kw: Any) -> None:
    print(event + " " + json.dumps(kw, sort_keys=True), flush=True)


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def digest(path: Path, algo: str = "sha256") -> str:
    h = hashlib.new(algo)
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(8 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def load_helper():
    raw = urllib.request.urlopen(HELPER_URL, timeout=120).read()
    if len(raw) != HELPER_BYTES or sha256_bytes(raw) != HELPER_SHA256:
        raise RuntimeError("immutable v1.4 helper digest mismatch")
    path = WORK / "saghog_v14_helper.py"
