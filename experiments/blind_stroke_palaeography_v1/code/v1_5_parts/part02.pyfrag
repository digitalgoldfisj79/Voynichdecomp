

def balanced_indices(labels: np.ndarray, classes_per_batch: int, m: int, rng: np.random.Generator) -> np.ndarray:
    by = {c: np.flatnonzero(labels == c) for c in np.unique(labels)}
    cs = rng.choice(list(by), size=min(classes_per_batch, len(by)), replace=False)
    return np.concatenate([rng.choice(by[c], size=m, replace=len(by[c]) < m) for c in cs])


def page_vectors(wrapped, patch_x: np.ndarray, records: list[dict[str, Any]], keep: np.ndarray, device: str) -> tuple[np.ndarray, list[str]]:
    wrapped.eval()
    vectors: list[np.ndarray] = []
    writers: list[str] = []
    with torch.inference_mode():
        for idx in np.flatnonzero(keep):
            r = records[idx]
            total = None
            for s in range(r["start"], r["end"], 128):
                batch = eval_tensor(patch_x[s:min(s + 128, r["end"])], device)
                z = wrapped(batch).float().sum(0).cpu().numpy()
                total = z if total is None else total + z
            total = np.sign(total) * np.abs(total) ** 0.4
            total = total / max(float(np.linalg.norm(total)), 1e-12)
            vectors.append(total.astype(np.float32))
            writers.append(r["writer"])
    return np.stack(vectors), writers


@dataclass
class ResidualModel:
    n_mean: np.ndarray
    n_std: np.ndarray
    x_mean: np.ndarray
    x_std: np.ndarray
    beta: np.ndarray

    def apply(self, x: np.ndarray, n: np.ndarray) -> np.ndarray:
        nn = (n - self.n_mean) / self.n_std
        xx = (x - self.x_mean) / self.x_std
        nn = np.column_stack([np.ones(len(nn)), nn])
        return (xx - nn @ self.beta).astype(np.float32)


def fit_residual_model(x: np.ndarray, n: np.ndarray, alpha: float = 10.0) -> ResidualModel:
    nm, ns = n.mean(0), n.std(0)
    ns[ns < 1e-6] = 1
    xm, xs = x.mean(0), x.std(0)
    xs[xs < 1e-6] = 1
    nn = (n - nm) / ns
    xx = (x - xm) / xs
    nn1 = np.column_stack([np.ones(len(nn)), nn])
    reg = np.eye(nn1.shape[1], dtype=np.float32) * alpha
    reg[0, 0] = 0
    beta = solve(nn1.T @ nn1 + reg, nn1.T @ xx, assume_a="pos")
    return ResidualModel(nm, ns, xm, xs, beta)


def permutation_p(retrieval_fn, x: np.ndarray, writers: list[str], observed: float, n: int) -> dict[str, Any]:
    rng = np.random.default_rng(SEED + 91)
    labels = np.array(writers, object)
    null = []
    for _ in range(n):
        pl = labels.copy()
        rng.shuffle(pl)
        null.append(retrieval_fn(x, pl.tolist())["map"])
    p = (1 + sum(v >= observed for v in null)) / (n + 1)
    return {"p": p, "n": n, "null_mean": float(np.mean(null)), "null_sd": float(np.std(null))}


def k_calibration(x: np.ndarray, writers: list[str]) -> dict[str, Any]:
    rng = np.random.default_rng(SEED + 177)
    by: dict[str, list[int]] = defaultdict(list)
    for i, w in enumerate(writers):
        by[w].append(i)
    eligible = sorted(by)
    exact = within = total = 0
    details = []
