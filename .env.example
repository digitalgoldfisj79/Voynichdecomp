# PAL MCP Server configuration
#
# Copy this file to `.env` and fill in the keys for the providers you use.
# `.env` is gitignored, so your real keys are never committed.
#
# PAL needs AT LEAST ONE provider API key to be useful. Leave the rest blank.
# The `.mcp.json` in this repo reads these variables via ${VAR:-} expansion.

# ---- Provider API keys (set the ones you have) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
XAI_API_KEY=
DIAL_API_KEY=

# ---- PAL behaviour (optional; sensible defaults applied in .mcp.json) ----
# Model-selection strategy ("auto" lets PAL pick per task).
PAL_DEFAULT_MODEL=auto

# Comma-separated PAL tools to disable. Default keeps the heavier tools off;
# remove entries here to enable them (analyze, refactor, testgen, secaudit,
# docgen, tracer).
PAL_DISABLED_TOOLS=analyze,refactor,testgen,secaudit,docgen,tracer

# ---- Other PAL options (uncomment to override PAL's own defaults) ----
# DEFAULT_THINKING_MODE_THINKDEEP=high
# LOG_LEVEL=INFO
# CONVERSATION_TIMEOUT_HOURS=6
# MAX_CONVERSATION_TURNS=20
